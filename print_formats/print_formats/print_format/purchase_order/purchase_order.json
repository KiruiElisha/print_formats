 "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"{% if doc.letter_head == \\\"Default Letter Head\\\" %}\\r\\n  <h2 style=\\\"text-align: right;\\\">\\r\\n    Purchase Order<br>\\r\\n    <small>{{ doc.name }}</small>\\r\\n  </h2>\\r\\n{% endif %}\\r\\n\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"<table style=\\\"width: 100%; font-size: 10px; margin-top: 10px;\\\">\\r\\n     <tr style=\\\"vertical-align: top; width: 20%;\\\">\\r\\n            <p style=\\\"font-size: 12px;\\\"><b>Bill To,</b></p>\\r\\n        </tr>\\r\\n    <tr>\\r\\n       \\r\\n        <td style=\\\"vertical-align: top; width: 50%;\\\">\\r\\n            <div style=\\\"width: 100%; font-size: 10px;padding-left:40px;\\\">\\r\\n                <p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Supplier Code:</span> <b style=\\\"font-size: 10px;\\\">{{ doc.supplier }}</b></p>\\r\\n                <p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Supplier Name:</span> <b>{{ doc.supplier_name }}</b></p>\\r\\n                \\r\\n                <p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Supplier Pin:</span> <b>{{ frappe.db.get_value(\\\"Supplier\\\", doc.supplier, \\\"tax_id\\\") or ''}}</b></p>\\r\\n            </div>\\r\\n        </td>\\r\\n        <td style=\\\"vertical-align: top; width: 30%;\\\">\\r\\n            <div style=\\\"width: 100%; font-size: 10px;padding-left:40px;\\\">\\r\\n                <!--<p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Customer PO#:</span> <b style=\\\"font-size: 10px;\\\">{{ doc.po_no or '' }}</b></p>-->\\r\\n                <p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Required By:</span> <b style=\\\"font-size: 10px;\\\">{{ frappe.utils.formatdate(doc.schedule_date, \\\"dd-mm-yyyy\\\") or \\\"\\\"}}</b></p>\\r\\n               \\r\\n  \\r\\n               \\r\\n                \\r\\n            </div>\\r\\n        </td>\\r\\n    </tr>\\r\\n</table>\\r\\n\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"<table style=\\\"width:100%; font-size:11px; margin-top:10px\\\" border=\\\"1\\\">\\r\\n           <thead>\\r\\n            <tr style=\\\"font-weight: bold;\\\">\\r\\n                <th>SR No.</th>\\r\\n                <th>Item Code</th>\\r\\n                <th>Item Name</th>\\r\\n                <th class=\\\"text-right\\\">UOM</th>\\r\\n                <th class=\\\"text-right\\\">Qty</th>\\r\\n                <th class=\\\"text-right\\\">Unit Price</th>\\r\\n                <th class=\\\"text-right\\\">Total</th>\\r\\n            </tr>\\r\\n        </thead>\\r\\n\\r\\n    <tbody>\\r\\n        {% set gross_total = 0 %}\\r\\n        \\r\\n        {% for row in doc.items %}\\r\\n            {% set amount = row.net_amount or 0 %}\\r\\n            {% set rate = row.rate or 0 %}\\r\\n            {% set qty = row.qty or 0 %}\\r\\n            \\r\\n            {% set total_amount = amount %}\\r\\n            \\r\\n            {% set gross_total = gross_total + total_amount %}\\r\\n            \\r\\n            <tr>\\r\\n                <td>{{ row.idx }}</td>\\r\\n                <td>{{ row.item_code }}</td>\\r\\n                <td>{{ row.item_name }}</td>\\r\\n                <td class=\\\"text-right\\\">{{ row.uom }}</td>\\r\\n                <td class=\\\"text-right\\\">{{ qty }}</td>\\r\\n                <td class=\\\"text-right\\\">{{ '{0:,.2f}'.format(rate) }}</td>\\r\\n                <td class=\\\"text-right\\\">{{ '{0:,.2f}'.format(total_amount) }}</td>\\r\\n            </tr>\\r\\n        {% endfor %}\\r\\n    </tbody>\\r\\n    <tfoot>\\r\\n        <tr>\\r\\n            <td></td>\\r\\n            <td colspan=\\\"3\\\" class=\\\"text-right\\\"><b>Total:</b></td>\\r\\n            <td class=\\\"text-right\\\"><b>{{ doc.total_qty }}</b></td>\\r\\n            <td></td>\\r\\n            <td class=\\\"text-right\\\"><b>{{ '{0:,.2f}'.format(doc.net_total) }}</b></td>\\r\\n        </tr>\\r\\n    </tfoot>\\r\\n</table>\\r\\n\\r\\n<table style=\\\"width:100%; font-size:11px; margin-top:2px\\\" border=\\\"1\\\">\\r\\n    <tr>\\r\\n        <td colspan=\\\"9\\\" class=\\\"text-left\\\"><b>Total Amount in words: {{ frappe.utils.money_in_words(doc.net_total, doc.currency or 'USD') }}</b></td>\\r\\n    </tr>\\r\\n    <tr>\\r\\n        <td colspan=\\\"6\\\" width=\\\"60%\\\">\\r\\n            Terms & Conditions: <p>{{ doc.terms or '' }}</p><br>\\r\\n        </td>\\r\\n        <td colspan=\\\"3\\\" width=\\\"40%\\\" style=\\\"text-align:right;\\\">\\r\\n            <table class=\\\"table table-sm\\\" style=\\\"margin-top:0px\\\">\\r\\n                <tr>\\r\\n                    <td colspan=\\\"2\\\"><b>Sub Total</b></td>\\r\\n                    <td colspan=\\\"2\\\" style=\\\"text-align:right;\\\"><b>{{ doc.currency }} {{ '{0:,.2f}'.format(doc.net_total or 0) }}</b></td>\\r\\n                </tr>\\r\\n                <tr>\\r\\n                    <td colspan=\\\"2\\\"><b>VAT</b></td>\\r\\n                    <td colspan=\\\"2\\\" style=\\\"text-align:right;\\\"><b>{{ doc.currency }} {{ '{0:,.2f}'.format(doc.total_taxes_and_charges or 0) }}</b></td>\\r\\n                </tr>\\r\\n                <tr>\\r\\n                    <td colspan=\\\"2\\\"><b>Total Amount</b></td>\\r\\n                    <td colspan=\\\"2\\\" style=\\\"text-align:right;\\\"><b>{{ doc.currency }} {{ '{0:,.2f}'.format(doc.grand_total or 0) }}</b></td>\\r\\n                </tr>\\r\\n            </table>\\r\\n        </td>\\r\\n    </tr>\\r\\n</table>\\r\\n\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"{% set footer = frappe.db.get_value(\\\"Letter Head\\\", doc.letter_head, \\\"footer\\\") %}\\r\\n\\r\\n\\r\\n<!--<div class=\\\"text-center\\\" style=\\\"font-size: 10px;\\\">-->\\r\\n<!--    <hr>-->\\r\\n<!--    <div id=\\\"footer-html\\\" class=\\\"visible-pdf\\\">-->\\r\\n<!--        <div class=\\\"letter-head-footer\\\">-->\\r\\n<!--           {{ footer | safe }}-->\\r\\n<!--        </div>-->\\r\\n<!--        <p class=\\\"small page-number visible-pdf\\\">-->\\r\\n<!--            {{ _(\\\"Page {0} of {1}\\\").format('<span class=\\\"page\\\"></span>', '<span class=\\\"topage\\\"></span>') }}-->\\r\\n<!--        </p>-->\\r\\n<!--    </div>-->\\r\\n<!--</div>-->\\r\\n\"}]",
