 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <title>{{ doc.company }}</title>\r\n</head>\r\n<body>\r\n   {% set company_name = frappe.db.get_value(\"Company\", doc.company, \"company_name\") %}\r\n{% set company_logo = frappe.db.get_value(\"Company\", doc.company, \"company_logo\") %}\r\n{% set company_phone_no = frappe.db.get_value(\"Company\", doc.company, \"phone_no\") %}\r\n{% set company_email = frappe.db.get_value(\"Company\", doc.company, \"email\") %}\r\n{% set company_website = frappe.db.get_value(\"Company\", doc.company, \"website\") %}\r\n{% set company_pin = frappe.db.get_value(\"Company\", doc.company, \"tax_id\") %}\r\n\r\n{% set address_name = frappe.db.get_value(\"Dynamic Link\", {\"link_doctype\": \"Company\", \"link_name\": doc.company, \"parenttype\": \"Address\"}, \"parent\") %}\r\n{% set company_address = frappe.db.get_value(\"Address\", address_name, [\"address_line1\", \"address_line2\", \"city\", \"pincode\", \"country\"], as_dict=True) %}\r\n\r\n{% set doc_label = {\r\n    \r\n    \"Sales Invoice\": \"Invoice #\"\r\n    \r\n}.get(doc.doctype, doc.doctype + \" #\") %}\r\n\r\n<div id=\"header-html\" style=\"margin: 20px auto; width: 98%; padding: 15px; border: 2px solid #000; border-radius: 8px; background-color: #f9f9f9; box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);\">\r\n    <div style=\"display: flex; align-items: flex-start;\">\r\n        <!-- Logo and Company Details -->\r\n        <div style=\"flex: 1; display: flex; align-items: flex-start;\">\r\n            {% if company_logo %}\r\n                <img src=\"{{ company_logo }}\" alt=\"Company Logo\" style=\"max-width: 100px; max-height: 120px; height: auto; margin-right: 20px; border: 1px solid #ccc; padding: 5px; border-radius: 5px;\">\r\n            {% else %}\r\n                <img src=\"/files/default_logo.jpeg\" alt=\"Default Company Logo\" style=\"max-width: 100px; max-height: 120px; height: auto; margin-right: 20px; border: 1px solid #ccc; padding: 5px; border-radius: 5px;\">\r\n            {% endif %}\r\n            <div style=\"font-size: 12px; line-height: 1.6; color: #333;\">\r\n                <strong style=\"font-size: 14px; color: #000;\">{{ company_name }}</strong><br>\r\n                {% if company_address %}\r\n                    {{ company_address.address_line1 }}{% if company_address.pincode %}, {{ company_address.pincode }}{% endif %}<br>\r\n                    {% if company_address.address_line2 %}\r\n                        {{ company_address.address_line2 }},<br>\r\n                    {% endif %}\r\n                    {{ company_address.city }},\r\n                    {{ company_address.country }}.<br>\r\n                {% endif %}\r\n                {% if company_phone_no %}\r\n                    Phone: {{ company_phone_no }}<br>\r\n                {% endif %}\r\n                {% if company_email %}\r\n                    Email: {{ company_email }}<br>\r\n                {% endif %}\r\n                {% if company_website %}\r\n                    Website: <a href=\"http://{{ company_website }}\" style=\"color: #0056b3; text-decoration: none;\">{{ company_website }}</a>\r\n                {% endif %}\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Table -->\r\n        <div style=\"flex: 0.8; text-align: left; margin-left: 20px;\">\r\n    <table class=\"table table-sm\" style=\"width: 100%; font-size: 11px; text-align: left; border-collapse: collapse;\">\r\n        <tbody>\r\n            <tr style=\"background-color: #0056b3; color: #fff; -webkit-print-color-adjust: exact; print-color-adjust: exact; color-adjust: exact;\">\r\n                <td colspan=\"2\" style=\"text-align: center; font-size: 14px; font-weight: bold; padding: 8px; border-radius: 4px; -webkit-print-color-adjust: exact; print-color-adjust: exact; color-adjust: exact;\">{{ doc.doctype | upper }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 5px; border-bottom: 1px solid ;\">Date:</td>\r\n                <td style=\"padding: 5px; border-bottom: 1px solid ;\">{{ frappe.utils.formatdate(doc.get(\"transaction_date\") or doc.get(\"posting_date\") or \"\", \"dd-MM-yyyy\") }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 5px; border-bottom: 1px ;\">{{ doc_label }}:</td>\r\n                <td style=\"padding: 5px; border-bottom: 1px ;\">{{ doc.name }}</td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n</div>\r\n    </div>\r\n\r\n\r\n\r\n        <!-- Bottom Section -->\r\n        <div style=\"display: flex; justify-content: space-between; border-top: 1px solid black; padding-top: 5px;\">\r\n            <div style=\"width: 33%; border: 1px solid black; padding: 5px; text-align: center;\">\r\n                <p style=\"margin: 0; font-weight: bold; font-size: 11px;\">VAT NO. {{ doc.tax_id or \"N/A\" }}</p>\r\n            </div>\r\n            <div style=\"width: 33%; border: 1px solid black; padding: 5px; text-align: center; margin: 0 5px;\">\r\n                <p style=\"margin: 0; font-weight: bold; font-size: 11px;\">Invoice No. {{ doc.name }}</p>\r\n            </div>\r\n            <div style=\"width: 33%; border: 1px solid black; padding: 5px; text-align: center;\">\r\n                <p style=\"margin: 0; font-weight: bold; font-size: 11px;\">PIN NO. {{ frappe.db.get_value(\"Company\", doc.company, \"tax_id\") or \"Not Available\" }}</p>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    \r\n    <!-- Billing Section -->\r\n    <div style=\"width: 100%; max-width: 700px; margin: 10px auto; font-family: Arial, sans-serif;\">\r\n        <p style=\"font-size: 11px; margin: 5px 0;\">Bill To: {{ doc.customer_name }}</p>\r\n        \r\n        <!-- Invoice Details -->\r\n        <table style=\"width: 100%; border-collapse: collapse; font-size: 9px;\">\r\n            <tr>\r\n                <td style=\"border: 1px solid black; padding: 4px; width: 50%;\">\r\n                       \r\n                    </td>\r\n                <td style=\"border: 1px solid black; padding: 4px;\">\r\n                    <table style=\"width: 100%; border-collapse: collapse;\">\r\n                        <tr>\r\n                            <td style=\"padding: 2px; font-size: 9px;\">Invoice No: {{ doc.name }}</td>\r\n                            <td style=\"padding: 2px; font-size: 9px;\">Date: {{ doc.posting_date }}</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td style=\"padding: 2px; font-size: 9px;\">Sales Rep:</td>\r\n                            <td style=\"padding: 2px; font-size: 9px;\">{{ frappe.db.get_value(\"User\", doc.owner , \"full_name\") or \"Not Available\" }}</td>\r\n                        </tr>\r\n\r\n                    </table>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n\r\n\r\n       <!-- Merged Table -->\r\n<style>\r\n    .qr-code-container {\r\n        text-align: center;\r\n        padding: 10px;\r\n        background-color: #f8f8f8;\r\n        border-radius: 8px;\r\n        border: 1px solid #ddd;\r\n        width: 150px;\r\n        margin: 0 auto;\r\n    }\r\n    .qr-code-image {\r\n        border: 1px solid white;\r\n        border-radius: 5px;\r\n        width: 100px;\r\n        height: 100px;\r\n    }\r\n</style>\r\n\r\n\r\n\r\n</style>\r\n\r\n<table style=\"width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 11px; border: 1px solid black;\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"border: 1px solid black; padding: 5px; text-align: left;\">Item Name</th>\r\n            <th style=\"border: 1px solid black; padding: 5px; text-align: center;\">Qty.</th>\r\n            <th style=\"border: 1px solid black; padding: 5px; text-align: right;\">Price {{ doc.currency }}</th>\r\n            <th style=\"border: 1px solid black; padding: 5px; text-align: right;\">Discount</th>\r\n            <th style=\"border: 1px solid black; padding: 5px; text-align: right;\">Total {{ doc.currency }}</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% for item in doc.items %}\r\n        <tr>\r\n            <td style=\"border: 1px solid black; padding: 5px;\">{{ item.item_name }}</td>\r\n            <td style=\"border: 1px solid black; padding: 5px; text-align: center;\">{{ item.qty }}</td>\r\n            <td style=\"border: 1px solid black; padding: 5px; text-align: right;\">{{ item.rate }}</td>\r\n            <td style=\"border: 1px solid black; padding: 5px; text-align: right;\">{{ item.discount_percentage or 0 }}%</td>\r\n            <td style=\"border: 1px solid black; padding: 5px; text-align: right;\">{{ item.amount }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n    <tfoot>\r\n        <tr>\r\n            <td colspan=\"3\" rowspan=\"3\" style=\"vertical-align: middle;\">\r\n                \r\n            </td>\r\n            <td colspan=\"\" style=\"border: 1px solid black; padding: 5px; text-align: right;\">Subtotal</td>\r\n            <td style=\"border: 1px solid black; padding: 5px; text-align: right;\">{{ doc.currency }} {{ doc.net_total }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"\" style=\"border: 1px solid black; padding: 5px; text-align: right;\">Tax</td>\r\n            <td style=\"border: 1px solid black; padding: 5px; text-align: right;\">{{ doc.currency }} {{ doc.total_taxes_and_charges }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"\" style=\"border: 1px solid black; padding: 5px; text-align: right;\">Total</td>\r\n            <td style=\"border: 1px solid black; padding: 5px; text-align: right;\">{{ doc.currency }} {{ doc.grand_total }}</td>\r\n        </tr>\r\n    </tfoot>\r\n    <tr style=\"border: 1px solid black;\">\r\n        <td style=\"vertical-align: middle;\">\r\n            {% for payment in doc.payments %}\r\n                            {{ payment.mode_of_payment }}{% if not loop.last %}, {% endif %}\r\n                        {% endfor %}</td>\r\n        \r\n    </tr>\r\n</table>\r\n\r\n\r\n    \r\n    <!-- Footer Section -->\r\n            <div style=\"text-align: center; font-size: 9px; margin-top: 20px;\">\r\n              \r\n            </div>\r\n            <div style=\"position: fixed; bottom: 0; left: 0; width: 100%; text-align: center; padding: 10px 0; font-size: 10px; color: #666; background-color: #ffffff; border-top: 1px solid #e9ecef; z-index: 1000;\">\r\n   \r\n</div>\r\n\r\n\r\n</body>\r\n</html>\r\n",
