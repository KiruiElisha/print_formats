 "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"<h1></h1>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"<table id=\\\"tab1\\\"  style = \\\"width:100%; font-size:11px; margin-top:10px;\\\">\\r\\n    <tr style = \\\"width:100%; border:0px solid red;\\\"> \\r\\n        <td id=\\\"cell1\\\" style = \\\"width:100%; border:0px solid black;\\\">  \\r\\n            <div style=\\\"width:100%;\\\">\\r\\n                <div>\\r\\n                    \\r\\n                    <p style=\\\"padding: 5px 5px 5px 5px;\\\">{% if doc.payment_type=='Pay' %} Paid To: {% elif doc.payment_type=='Receive' %} Received from: {% endif %}  <span style=\\\"margin-left: 30px; font-weight:bold; text-transform:uppercase;\\\">{{doc.party_name }}</span>   </p>\\r\\n                    <!--<p style=\\\"padding: 5px 5px 5px 5px;\\\">Paid To:   <span style=\\\"margin-left: 30px;\\\">{{doc.party_name }}</span>   </p>-->\\r\\n                </div>\\r\\n                <div width=100%>\\r\\n                    <div style=\\\"float:left; padding: 5px 5px 5px 5px;\\\">Currency:</div>\\r\\n                    <div style=\\\"float:left; margin-left:60px; height: 30px; width: 15%; border-radius: 5px; padding: 5px 5px 5px 5px; border: 1px solid black;\\\">  KES  </div>\\r\\n                    <div style=\\\"float:left; margin-left:260px;padding: 5px 5px 5px 5px; \\\"> Amount :</div>\\r\\n                    <div style=\\\"float:left; margin-left:10px; height: 30px; width: 15%; border-radius: 5px; padding: 5px 5px 5px 5px; border: 1px solid black;\\\"> {{'{0:,.2f}'.format(doc.total_allocated_amount) }}  </div>\\r\\n                </div>\\r\\n                <div style=\\\"width:100%; margin-top:10px\\\">\\r\\n                    <div style=\\\"float:left; margin-top:10px; padding: 5px 5px 5px 5px;\\\">Amount in words:</div>\\r\\n                    <div style=\\\"float:left; margin-top:10px; margin-left:20px; height: 40px; width: 80%; border-radius: 5px; padding: 5px 5px 5px 5px; border: 1px solid black; text-align:left;\\\">\\r\\n                        {{ frappe.utils.money_in_words(doc.total_allocated_amount) }} \\r\\n                        </div>\\r\\n                </div>\\r\\n            </div>\\r\\n        </td>\\r\\n    </tr>\\r\\n</table>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"<table style = \\\"width:98%; font-size:11px;  margin-top:10px; border: 1px solid black;\\\">\\r\\n    <tr width=100% style = \\\"border-bottom:0px solid white;\\\">\\r\\n        <td class=\\\"cheque\\\" colspan=\\\"2\\\" width=50% style=\\\"\\\"><b>Payment Type: {{doc.mode_of_payment}}</b></td>\\r\\n    </tr>\\r\\n    <tr width=100% style = \\\"border-top: 0px solid green; border-bottom:0px;\\\">\\r\\n        <td  class=\\\"cheque\\\" width=50%>Cheque No:  {{ doc.reference_no  }}  </td>\\r\\n        <td  class=\\\"cheque\\\" width=50%>Cheque Maturity Date: {{ doc.reference_date }}  </td>\\r\\n    </tr>\\r\\n    <tr width=100% style = \\\"border-top: 0px solid black;\\\">\\r\\n        <td class = \\\"cheque\\\" colspan=\\\"2\\\" width=50%>Bank Name: {{ doc.bank }} </td>\\r\\n        \\r\\n    </tr>\\r\\n</table>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"\\r\\n<table style = \\\"width:98%; font-size:11px;  margin-top:20px\\\">\\r\\n    <tr width=100% style=\\\"border:1px solid black;\\\">\\r\\n        <th colspan=\\\"8\\\" style=\\\"border:1px solid black; font-size:11px; font-weight:bold;\\\"> Payment Details:</th>\\r\\n    </tr>\\r\\n    <tr width=98%>\\r\\n        <th class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\"> # </th>\\r\\n        <th class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\">Inv No.</th>\\r\\n        <th class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\">Inv Date</th>\\r\\n        <th class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\">Inv Amount</th>\\r\\n        <th class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\">Amount Paid</th>\\r\\n        <th class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\">Chq Amount</th>\\r\\n    </tr>\\r\\n    {% set total_amount = {\\\"total_amount\\\":0} %}\\r\\n    {% for row in doc.references %}\\r\\n    {% if total_amount.update({\\\"total_amount\\\": total_amount[\\\"total_amount\\\"] + row.allocated_amount}) %} {% endif %}\\r\\n    <tr width=100%>\\r\\n        <td class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\">{{row.idx}}</td>\\r\\n        <td class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\">{{row.bill_no}}</td>\\r\\n        <td class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\">{{frappe.format(frappe.db.get_value(row.reference_doctype, row.reference_name, 'posting_date'), {'fieldtype' : 'Date'})}}</td>\\r\\n        <td class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\">{{'{0:,.2f}'.format(row.total_amount)}}</td>\\r\\n        <td class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\">{{'{0:,.2f}'.format(row.allocated_amount)}}</td>\\r\\n        <td class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\">{{'{0:,.2f}'.format(row.allocated_amount)}}</td>\\r\\n    </tr>\\r\\n    {% endfor %}\\r\\n    <tr width=100%>\\r\\n        <td colspan = \\\"5\\\" class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;text-align:right;\\\">Total:</td>\\r\\n        <td class=\\\"cheque\\\" style=\\\"font-size:11px; font-weight:bold;\\\">{{'{0:,.2f}'.format(total_amount[\\\"total_amount\\\"])}}</td>\\r\\n    </tr>\\r\\n</table>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"\\r\\n<table style = \\\"width:98%; font-size:11px;  margin-top:30px\\\">\\r\\n    <tr width=100% style=\\\"border:1px solid black;\\\">\\r\\n        <td width=50% style=\\\"border:1px solid black; font-size:11px; font-weight:bold;\\\"> <b> Paid By:{{ doc.paid_from  }} </b> </td>\\r\\n        <td width=50% style=\\\"border:1px solid black; font-size:11px; font-weight:bold;\\\"><b>  </b></td>\\r\\n    </tr>\\r\\n    <tr width=100%>\\r\\n        <td width=50% style=\\\"border:1px solid black; font-size:11px; font-weight:bold;\\\"> <b> Paid On: {{frappe.utils.formatdate(doc.get_formatted('posting_date'), \\\"dd-mm-yyyy\\\") }} </b> </td>\\r\\n        <td width=50% style=\\\"border:1px solid black; font-size:11px; font-weight:bold;\\\"><b> Authorized By: {% if doc.docstatus==1 %} {{doc.owner}} {% endif %}</b> </td>\\r\\n    </tr>\\r\\n    <tr width=100%>\\r\\n        <td colspan=\\\"2\\\" width=50% style=\\\"border:1px solid black; font-size:11px;\\\"> <i>To be filled by customer.</i> </td>\\r\\n    </tr>\\r\\n    <tr width=100%>\\r\\n        <td colspan=\\\"2\\\" width=50% style=\\\"border:1px solid black; font-size:11px; font-weight:bold;\\\"> <b> Cheque/Cash Received By: -- </b> </td>\\r\\n    </tr>\\r\\n    <tr width=100%>\\r\\n        <td width=50% style=\\\"border:1px solid black; font-size:11px; font-weight:bold;\\\"> <b> Name: -- </b> </td>\\r\\n        <td width=50% style=\\\"border:1px solid black; font-size:11px; font-weight:bold;\\\"><b> ID No: -- </b> </td>\\r\\n    </tr>\\r\\n    <tr width=100%>\\r\\n        <td colspan=\\\"2\\\" width=50% height=60px style=\\\"border:1px solid black; font-size:11px; font-weight:bold;\\\"> <b> Signature:  </b> </td>\\r\\n    </tr>\\r\\n</table>\\r\\n\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"{% set footer = frappe.db.get_value(\\\"Letter Head\\\", doc.letter_head, \\\"footer\\\") %}\\r\\n\\r\\n{% set footer_updated = frappe.render_template(footer, {\\\"created_by\\\": doc.owner, \\\"creation\\\": frappe.utils.now(), \\\"user_phone\\\": frappe.db.get_value(\\\"User\\\", frappe.session.user, \\\"mobile_no\\\"), \\\"user\\\": frappe.session.user}) %}\\r\\n\\r\\n<div class=\\\"text-center\\\" style=\\\"font-size: 10px;\\\">\\r\\n    <hr>\\r\\n    <div id=\\\"footer-html\\\" class=\\\"visible-pdf\\\">\\r\\n        <div class=\\\"letter-head-footer\\\">\\r\\n           {{ footer_updated | safe }}\\r\\n        </div>\\r\\n        <p class=\\\"small page-number visible-pdf\\\">\\r\\n            {{ _(\\\"Page {0} of {1}\\\").format('<span class=\\\"page\\\"></span>', '<span class=\\\"topage\\\"></span>') }}\\r\\n        </p>\\r\\n    </div>\\r\\n</div>\\r\\n\"}]",
