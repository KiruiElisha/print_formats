 "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"<h1></h1>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"<table style=\\\"width: 100%; font-size: 10px; margin-top: 10px;\\\">\\r\\n     \\r\\n    <tr>\\r\\n      \\r\\n        <td style=\\\"vertical-align: top; width: 50%;\\\"><b>Bill To:</b>\\r\\n            <div style=\\\"width: 100%; font-size: 10px;padding-left:30px;\\\">\\r\\n                <p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Customer Code:</span> <b style=\\\"font-size: 10px;\\\">{{ doc.customer }}</b></p>\\r\\n                <p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Customer Name:</span> <b>{{ doc.customer_name }}</b></p>\\r\\n                <p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">City:</span> <b>{{ frappe.db.get_value(\\\"Customer\\\", doc.customer, \\\"territory\\\") or '' }}</b></p>\\r\\n                <p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Customer Pin:</span> <b>{{ frappe.db.get_value(\\\"Customer\\\", doc.customer, \\\"tax_id\\\") or ''}}</b></p>\\r\\n            </div>\\r\\n        </td>\\r\\n        <td style=\\\"vertical-align: top; width: 30%;\\\"><b>Details:</b>\\r\\n            <div style=\\\"width: 100%; font-size: 10px;padding-left:30px;\\\">\\r\\n                <!--<p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Customer PO#:</span> <b style=\\\"font-size: 10px;\\\">{{ doc.po_no or '' }}</b></p>-->\\r\\n                <p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Delivery Date:</span> <b style=\\\"font-size: 10px;\\\">{{ frappe.utils.formatdate(doc.delivery_date, \\\"dd-mm-yyyy\\\") }}</b></p>\\r\\n                <p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Customer's Purchase order:</span> <b style=\\\"font-size: 10px;\\\">{{ doc.po_no or ''}}</b></p>\\r\\n                <p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Customer's Purchase order Date:</span> <b style=\\\"font-size: 10px;\\\">{{ frappe.utils.formatdate(doc.po_date, \\\"dd-mm-yyyy\\\") }}</b></p>\\r\\n                <p style=\\\"margin-bottom: 5px;\\\"><span style=\\\"font-size: 11px;\\\">Tax Id:</span> <b style=\\\"font-size: 10px;\\\">{{ doc.tax_id or ''}}</b></p>\\r\\n               \\r\\n                \\r\\n            </div>\\r\\n        </td>\\r\\n    </tr>\\r\\n</table>\\r\\n\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"<table style=\\\"width:98%; font-size:11px;font-weight:bold; margin-top:10px; border-collapse: collapse;\\\" border=\\\"1\\\">\\n    <thead>\\n        <tr>\\n    <th style=\\\"font-weight: bold;\\\">SR No.</th>\\n    <th style=\\\"font-weight: bold;\\\">Item Code</th>\\n    <th class=\\\"text-right\\\" style=\\\"font-weight: bold;\\\">Item Description</th>\\n    <th class=\\\"text-right\\\" style=\\\"font-weight: bold;\\\">UOM</th>\\n    <th class=\\\"text-right\\\" style=\\\"font-weight: bold;\\\">Qty</th>\\n    <!--<th class=\\\"text-right\\\" style=\\\"font-weight: bold;\\\">Rate</th>-->\\n    <th class=\\\"text-right\\\" style=\\\"font-weight: bold;\\\">Tax(%)</th>\\n    <th class=\\\"text-right\\\" style=\\\"font-weight: bold;\\\">Unit Price</th>\\n    <th class=\\\"text-right\\\" style=\\\"font-weight: bold;\\\">Total</th>\\n</tr>\\n\\n        \\n    </thead>\\n\\n    <tbody>\\n        {% set gross_total = 0 %}\\n        \\n        {% for row in doc.items %}\\n            {% set amount = row.net_amount or 0 %}\\n            {% set rate = row.rate or 0 %}\\n            {% set tax_percentage = row.total_tax_percentage or 0 %}\\n            {% set qty = row.qty or 0 %}\\n            \\n            {% set total_amount = amount %}\\n            {% set total_amnt = row.amount %}\\n            {% set discount = row.discount_amount %}\\n            {% set total_incl = total_amnt + discount %}\\n            {% set gross_total = gross_total + total_amount %}\\n            \\n            <tr>\\n                <td style=\\\"vertical-align: top;\\\">{{ row.idx }}</td>\\n                <td style=\\\"vertical-align: top;\\\">{{ row.item_code }}</td>\\n                <td style=\\\"vertical-align: top; margin-top: -1px; padding-top: -1px;\\\">{{ row.description }}</td>\\n                <td class=\\\"text-right\\\" style=\\\"vertical-align: top;\\\">{{ row.uom }}</td>\\n                <td class=\\\"text-right\\\" style=\\\"vertical-align: top;\\\">{{ qty }}</td>\\n                <td class=\\\"text-right\\\" style=\\\"vertical-align: top;\\\">{{ '{0:,.2f}'.format(tax_percentage) }}</td>\\n                <td class=\\\"text-right\\\" style=\\\"vertical-align: top;\\\">{{ '{0:,.2f}'.format(rate) }}</td>\\n                \\n                <td class=\\\"text-right\\\" style=\\\"vertical-align: top;\\\">{{ '{0:,.2f}'.format(total_amount) }}</td>\\n            </tr>\\n        {% endfor %}\\n    </tbody>\\n\\n    <tfoot>\\n        <tr>\\n            \\n            <td colspan=\\\"4\\\" class=\\\"text-right\\\"><b>Total:</b></td>\\n            <td class=\\\"text-right\\\"><b>{{ doc.total_qty }}</b></td>\\n            <td></td>\\n            <td></td>\\n            <td class=\\\"text-right\\\"><b>{{ '{0:,.2f}'.format(doc.net_total) }}</b></td>\\n        </tr>\\n    </tfoot>\\n</table>\\n\\n<table style=\\\"width:98%; font-size:11px; margin-top:2px; border-collapse: collapse;\\\" border=\\\"1\\\">\\n    <tr>\\n        <td colspan=\\\"9\\\" class=\\\"text-left\\\"><b>Total Amount in words: {{ frappe.utils.money_in_words(doc.net_total, doc.currency or 'USD') }}</b></td>\\n    </tr>\\n    <tr>\\n        <td colspan=\\\"6\\\" width=\\\"60%\\\">\\n            Terms & Conditions: <p>{{ doc.terms or '' }}</p><br>\\n            Additional notes: <p>{{ doc.posa_notes or '' }}</p>\\n        </td>\\n        <td colspan=\\\"3\\\" width=\\\"40%\\\" style=\\\"text-align:right;\\\">\\n            <table class=\\\"table table-sm\\\" style=\\\"margin-top:0px; border-collapse: collapse;\\\">\\n                <tr>\\n                    <td colspan=\\\"2\\\"><b>Total Incl. Amount</b></td>\\n                    <td colspan=\\\"2\\\" style=\\\"text-align:right;\\\"><b>{{ doc.currency }} {{ '{0:,.2f}'.format(doc.grand_total or 0) }}</b></td>\\n                </tr>\\n                <tr>\\n                    <td colspan=\\\"2\\\"><b>Discount</b></td>\\n                    <td colspan=\\\"2\\\" style=\\\"text-align:right;\\\"><b>{{ doc.currency }} {{ '{0:,.2f}'.format(doc.total_discount_amount or 0) }}</b></td>\\n                </tr>\\n                <tr>\\n                    <td colspan=\\\"2\\\"><b>VAT</b></td>\\n                    <td colspan=\\\"2\\\" style=\\\"text-align:right;\\\"><b>{{ doc.currency }} {{ '{0:,.2f}'.format(doc.total_taxes_and_charges or 0) }}</b></td>\\n                </tr>\\n                <tr>\\n                    <td colspan=\\\"2\\\"><b>Total Amount</b></td>\\n                    <td colspan=\\\"2\\\" style=\\\"text-align:right;\\\"><b>{{ doc.currency }} {{ '{0:,.2f}'.format(doc.grand_total or 0) }}</b></td>\\n                </tr>\\n            </table>\\n        </td>\\n    </tr>\\n</table>\\n\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"{% set footer = frappe.db.get_value(\\\"Letter Head\\\", doc.letter_head, \\\"footer\\\") %}\\r\\n\\r\\n\\r\\n<!--<div class=\\\"\\\" style=\\\"font-size: 10px;\\\">-->\\r\\n<!--    <hr>-->\\r\\n<!--    <div id=\\\"\\\" class=\\\"\\\">-->\\r\\n<!--        <div class=\\\"\\\">-->\\r\\n<!--           {{ footer | safe }}-->\\r\\n<!--        </div>-->\\r\\n       \\r\\n<!--    </div>-->\\r\\n<!--</div>-->\\r\\n\"}]",
